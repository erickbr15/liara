# ================================
# Default: todo texto en LF
# ================================
* text=auto eol=lf

# ================================
# Código fuente (LF)
# ================================
*.cs        text eol=lf
*.csproj    text eol=lf
*.sln       text eol=lf
*.json      text eol=lf
*.xml       text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.md        text eol=lf
*.txt       text eol=lf
*.js        text eol=lf
*.jsx       text eol=lf
*.ts        text eol=lf
*.tsx       text eol=lf
*.css       text eol=lf
*.scss      text eol=lf
*.html      text eol=lf
*.sh        text eol=lf
Dockerfile  text eol=lf

# ================================
# Archivos Windows (CRLF)
# ================================
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf
*.psm1      text eol=crlf
*.psd1      text eol=crlf
*.reg       text eol=crlf

# ================================
# Binarios (no tocar)
# ================================
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.pdf       binary
*.zip       binary
*.7z        binary
*.dll       binary
*.exe       binary
*.pdb       binary